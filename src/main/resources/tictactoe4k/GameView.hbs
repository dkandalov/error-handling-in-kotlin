<meta charset="UTF-8">
<link rel="stylesheet" href="/static/styles.css">
<body>
<div class="game">
{{#each rows~}}
    <p class="row">
        {{#each this}}
            {{~#if player~}}
                {{player}}
            {{~else~}}
                <a href="/game/{{gameId}}/move?x={{x}}&y={{y}}">_</a>
            {{~/if~}}
            &nbsp;
        {{/each}}
    </p>
{{~/each}}
{{#if over~}}
    {{~#if winner~}}
        {{winner}} wins!! 🥳
    {{~else~}}
        It's a draw!
    {{~/if}}
    <br/>
    <a href="/">Start new game</a>?
{{~/if~}}
</div>
<script>
    (function() {
        const es = new EventSource("/game/events?gameId={{gameId}}");
        es.addEventListener("update", function() { location.reload(); });
    })();
</script>
</body>